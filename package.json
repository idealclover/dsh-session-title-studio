{
  "name": "@idealclover/dsh-session-title-studio",
  "version": "0.8.0",
  "description": "Configurable session titles for DeepSeek Harness: prompt/format recipes, refresh policies, a visual settings page, and local topic-drift detection.",
  "author": "idealclover",
  "homepage": "https://github.com/idealclover/dsh-session-title-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idealclover/dsh-session-title-studio.git"
  },
  "bugs": {
    "url": "https://github.com/idealclover/dsh-session-title-studio/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "session-title",
    "bundle"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./policy": "./lib/policy.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "docs/*.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-commands": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.1",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-session-title": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-session-title-llm": "^0.2.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js && node --check lib/studio.js && node --check lib/policy.js && npm test"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
